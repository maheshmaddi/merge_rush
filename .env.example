# Copy to .env.production and fill in your AdMob ad unit IDs before building
# the Play Store release. Without them the app shows Google's TEST ads, which
# earn nothing. Ad unit IDs are not secret; committing .env.production is fine.
#
# AdMob console → Apps → Merge Rush → Ad units:
#   "Continue (revive)"  - format: Rewarded
#   "Between games"      - format: Interstitial

VITE_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN

# The AdMob *app* ID (with "~") goes in android/gradle.properties instead:
#   ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~NNNNNNNNNN

# Google Play Games Services leaderboard IDs (Play Console > Play Games Services).
# Leave empty to keep leaderboards hidden. Also set PGS_APP_ID in android/gradle.properties.
VITE_PGS_ALL_TIME_ID=
VITE_PGS_DAILY_ID=
